{
  "tests": [
    {
      "name": "GET ?action=me без сессии — 401",
      "method": "GET",
      "path": "/?action=me",
      "expectedStatus": 401,
      "expectedBody": {"error": "Не авторизован"},
      "bodyMatcher": "partial"
    },
    {
      "name": "POST ?action=register — успешная регистрация",
      "method": "POST",
      "path": "/?action=register",
      "body": {"name": "Тест Мама", "email": "testmama_unique99@example.com", "password": "secret123"},
      "expectedStatus": 200,
      "expectedBody": {"session_id": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "POST ?action=login — неверный пароль",
      "method": "POST",
      "path": "/?action=login",
      "body": {"email": "testmama_unique99@example.com", "password": "wrongpass"},
      "expectedStatus": 401,
      "expectedBody": {"error": "Неверный email или пароль"},
      "bodyMatcher": "partial"
    }
  ]
}
